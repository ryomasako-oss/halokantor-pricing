# Copy to .env and fill in. Never commit .env.
PORT=8787
NODE_ENV=development

# Signs login cookies. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Anthropic API key for the pricing assistant. Leave blank to run without AI.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Seed administrator (created once on first run)
ADMIN_EMAIL=admin@salvator.co.id
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# SQLite location
DATABASE_PATH=./data/halokantor.db

# Base URL the notification emails/WhatsApp messages link back to.
APP_URL=http://localhost:5173

# Approval-workflow notifications (submit -> notify managers, decide ->
# notify the submitting rep). Leave either group blank to run without that
# channel — both are optional and independent of each other.

# Email via Resend (https://resend.com). RESEND_FROM_EMAIL must be a
# verified sender/domain in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WhatsApp via Twilio (https://www.twilio.com/whatsapp). TWILIO_WHATSAPP_FROM
# is your Twilio WhatsApp-enabled number, e.g. +14155238886 for the sandbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
