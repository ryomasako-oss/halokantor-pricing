# Copy to .env and fill in. Never commit .env.
PORT=8787
NODE_ENV=development

# Signs login cookies. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Anthropic API key for the pricing assistant. Leave blank to run without AI.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Seed administrator (created once on first run)
ADMIN_EMAIL=admin@salvator.co.id
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# SQLite location
DATABASE_PATH=./data/halokantor.db
